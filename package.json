{
  "name": "@tjdals12/design-spec",
  "version": "2.1.0-next.4",
  "description": "Spec-driven design requirements for AI coding agents",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjdals12/DesignSpec.git"
  },
  "main": "index.js",
  "bin": {
    "design-spec": "./bin/design-spec.js"
  },
  "files": [
    "bin/",
    "dist/",
    "schemas/",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "imports": {
    "#core/*": "./dist/core/*",
    "#utils/*": "./dist/utils/*",
    "#workflows/*": "./dist/workflows/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:cli": "pnpm build && node bin/design-spec.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "Seongmin Lee",
  "license": "MIT",
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@inquirer/core": "11.2.0",
    "@inquirer/prompts": "^8.5.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "dedent": "^1.7.2",
    "es-toolkit": "^1.46.0",
    "ora": "^9.4.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  }
}
